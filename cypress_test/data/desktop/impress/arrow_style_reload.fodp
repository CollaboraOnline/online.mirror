  <!-- The markers are written the way documents saved before the palette moved to the origin
       carry them: the viewBox origin is the bounding box minimum of the polygon, not 0 0. -->
  <office:styles>
    <draw:marker draw:name="CF_20_Zero_20_Many" draw:display-name="CF Zero Many" svg:viewBox="-1500 -4500 3000 6001" svg:d="M-1500 0c0-263 69-522 201-749 132-229 321-418 549-550 228-131 487-201 750-201s522 70 750 201c228 132 417 321 549 549 132 229 201 487 201 750 0 264-69 522-201 750-132 229-321 418-549 550-228 131-487 201-750 201s-522-70-750-201c-228-132-417-321-549-549s-201-487-201-750M-1350 0c0-237 62-469 181-674 118-206 289-376 494-495 205-118 438-181 675-181s470 63 675 181c205 119 376 289 494 494 119 206 181 439 181 675 0 237-62 470-181 675-118 206-289 376-494 495-205 118-438 181-675 181s-470-63-675-181c-205-119-376-289-494-494-119-206-181-438-181-675M0-1500l1500-2789v-211h-114l-1286 2392v-2392h-200v2392l-1286-2392h-114v211z"/>
    <draw:marker draw:name="Arrow" svg:viewBox="0 0 20 20" svg:d="M0 20l10-20 10 20z"/>
    <style:presentation-page-layout style:name="AL1T0">
      <presentation:placeholder presentation:object="title" svg:x="1.4cm" svg:y="0.837cm" svg:width="25.199cm" svg:height="3.506cm"/>
    </style:presentation-page-layout>
  </office:styles>
  <office:automatic-styles>
    <style:page-layout style:name="PM1">
      <style:page-layout-properties fo:margin-top="0cm" fo:margin-bottom="0cm" fo:margin-left="0cm" fo:margin-right="0cm" fo:page-width="28cm" fo:page-height="15.75cm" style:print-orientation="landscape"/>
    </style:page-layout>
    <style:style style:name="dp1" style:family="drawing-page"/>
    <style:style style:name="gr1" style:family="graphic">
      <style:graphic-properties draw:stroke="solid" svg:stroke-width="0.05cm" svg:stroke-color="#000000" draw:fill="solid" draw:fill-color="#729fcf" draw:marker-start="CF_20_Zero_20_Many" draw:marker-start-width="0.5cm" draw:marker-end="Arrow" draw:marker-end-width="0.5cm"/>
    </style:style>
