<!-- A read-only user layer for CppunitTest_configmgr_unit: it finalizes MacroSecurityLevel the
     way an administrator's policy (winreg or macosprefs layer) would. -->
<oor:items xmlns:oor="http://openoffice.org/2001/registry" xmlns:xs="http://www.w3.org/2001/XMLSchema" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
<item oor:path="/org.openoffice.Office.Common/Security/Scripting"><prop oor:name="MacroSecurityLevel" oor:finalized="true"><value>3</value></prop></item>
</oor:items>
