<?xml version="1.0" encoding="UTF-8"?>
<interface domain="vcl">
  <requires lib="gtk+" version="3.24"/>
  <object class="GtkAdjustment" id="adjustment1">
    <property name="upper">100</property>
    <property name="step-increment">1</property>
    <property name="page-increment">10</property>
  </object>
  <object class="GtkAdjustment" id="adjustment2">
    <property name="upper">100</property>
    <property name="step-increment">1</property>
    <property name="page-increment">10</property>
  </object>
  <object class="GtkTreeStore" id="liststore1">
    <columns>
      <column type="gchararray"/>
      <column type="gchararray"/>
    </columns>
  </object>
  <object class="GtkTreeStore" id="liststore2">
    <columns>
      <column type="gchararray"/>
      <column type="gchararray"/>
    </columns>
  </object>
  <object class="GtkTreeStore" id="liststore3">
    <columns>
      <column type="GdkPixbuf"/>
      <column type="gchararray"/>
      <column type="gchararray"/>
    </columns>
  </object>
  <object class="GtkBox" id="box">
    <property name="visible">True</property>
    <property name="orientation">vertical</property>
    <child>
      <object class="GtkDrawingArea" id="drawingarea">
        <property name="visible">True</property>
      </object>
    </child>
    <child>
      <object class="GtkScrolledWindow" id="textscroll">
        <property name="visible">True</property>
        <property name="shadow-type">in</property>
        <child>
          <object class="GtkTextView" id="textview">
            <property name="visible">True</property>
          </object>
        </child>
      </object>
    </child>
    <child>
      <object class="GtkScrolledWindow" id="treescroll">
        <property name="visible">True</property>
        <property name="shadow-type">in</property>
        <child>
          <object class="GtkTreeView" id="treeview">
            <property name="visible">True</property>
            <property name="model">liststore1</property>
            <property name="headers-visible">False</property>
            <property name="search-column">0</property>
            <property name="show-expanders">False</property>
            <child internal-child="selection">
              <object class="GtkTreeSelection"/>
            </child>
            <child>
              <object class="GtkTreeViewColumn" id="treeviewcolumn1">
                <child>
                  <object class="GtkCellRendererText"/>
                  <attributes>
                    <attribute name="text">0</attribute>
                  </attributes>
                </child>
              </object>
            </child>
          </object>
        </child>
      </object>
    </child>
    <child>
      <object class="GtkScrolledWindow" id="headertreescroll">
        <property name="visible">True</property>
        <property name="shadow-type">in</property>
        <child>
          <object class="GtkTreeView" id="headertreeview">
            <property name="visible">True</property>
            <property name="model">liststore2</property>
            <property name="search-column">0</property>
            <property name="show-expanders">False</property>
            <child internal-child="selection">
              <object class="GtkTreeSelection"/>
            </child>
            <child>
              <object class="GtkTreeViewColumn" id="treeviewcolumn2">
                <property name="title">Column</property>
                <child>
                  <object class="GtkCellRendererText"/>
                  <attributes>
                    <attribute name="text">0</attribute>
                  </attributes>
                </child>
              </object>
            </child>
          </object>
        </child>
      </object>
    </child>
    <child>
      <object class="GtkScrolledWindow" id="iconscroll">
        <property name="visible">True</property>
        <property name="shadow-type">in</property>
        <child>
          <object class="GtkIconView" id="iconview">
            <property name="visible">True</property>
            <property name="model">liststore3</property>
            <property name="pixbuf-column">0</property>
          </object>
        </child>
      </object>
    </child>
    <child>
      <object class="GtkScrolledWindow" id="scrolledwindow">
        <property name="visible">True</property>
        <property name="shadow-type">in</property>
        <child>
          <object class="GtkViewport" id="viewport">
            <property name="visible">True</property>
            <child>
              <object class="GtkLabel" id="viewportlabel">
                <property name="visible">True</property>
                <property name="label">Scrolled</property>
              </object>
            </child>
          </object>
        </child>
      </object>
    </child>
    <child>
      <object class="GtkButton" id="button">
        <property name="label">Button</property>
        <property name="visible">True</property>
      </object>
    </child>
    <child>
      <object class="GtkToggleButton" id="togglebutton">
        <property name="label">Toggle</property>
        <property name="visible">True</property>
      </object>
    </child>
    <child>
      <object class="GtkCheckButton" id="checkbutton">
        <property name="label">Check</property>
        <property name="visible">True</property>
        <property name="draw-indicator">True</property>
      </object>
    </child>
    <child>
      <object class="GtkRadioButton" id="radiobutton">
        <property name="label">Radio</property>
        <property name="visible">True</property>
        <property name="draw-indicator">True</property>
      </object>
    </child>
    <child>
      <object class="GtkMenuButton" id="menubutton">
        <property name="visible">True</property>
      </object>
    </child>
    <child>
      <object class="GtkLinkButton" id="linkbutton">
        <property name="label">Link</property>
        <property name="visible">True</property>
      </object>
    </child>
    <child>
      <object class="GtkEntry" id="entry">
        <property name="visible">True</property>
      </object>
    </child>
    <child>
      <object class="GtkSpinButton" id="spinbutton">
        <property name="visible">True</property>
        <property name="adjustment">adjustment1</property>
      </object>
    </child>
    <child>
      <object class="GtkComboBoxText" id="listbox">
        <property name="visible">True</property>
        <items>
          <item>One</item>
        </items>
      </object>
    </child>
    <child>
      <object class="GtkComboBoxText" id="combobox">
        <property name="visible">True</property>
        <property name="has-entry">True</property>
        <items>
          <item>One</item>
        </items>
        <child internal-child="entry">
          <object class="GtkEntry"/>
        </child>
      </object>
    </child>
    <child>
      <object class="GtkLabel" id="label">
        <property name="visible">True</property>
        <property name="label">Label</property>
      </object>
    </child>
    <child>
      <object class="GtkImage" id="image">
        <property name="visible">True</property>
        <property name="icon-name">vcl/res/errorbox.png</property>
      </object>
    </child>
    <child>
      <object class="GtkSeparator" id="separator">
        <property name="visible">True</property>
      </object>
    </child>
    <child>
      <object class="GtkProgressBar" id="progressbar">
        <property name="visible">True</property>
      </object>
    </child>
    <child>
      <object class="GtkScale" id="scale">
        <property name="visible">True</property>
        <property name="adjustment">adjustment2</property>
      </object>
    </child>
    <child>
      <object class="GtkCalendar" id="calendar">
        <property name="visible">True</property>
      </object>
    </child>
    <child>
      <object class="GtkExpander" id="expander">
        <property name="visible">True</property>
        <child>
          <object class="GtkLabel" id="expanderchild">
            <property name="visible">True</property>
            <property name="label">Inside</property>
          </object>
        </child>
        <child type="label">
          <object class="GtkLabel" id="expanderlabel">
            <property name="visible">True</property>
            <property name="label">Expander</property>
          </object>
        </child>
      </object>
    </child>
    <child>
      <object class="GtkFrame" id="frame">
        <property name="visible">True</property>
        <child>
          <object class="GtkGrid" id="grid">
            <property name="visible">True</property>
            <child>
              <object class="GtkLabel" id="gridlabel">
                <property name="visible">True</property>
                <property name="label">Grid</property>
              </object>
              <packing>
                <property name="left-attach">0</property>
                <property name="top-attach">0</property>
              </packing>
            </child>
          </object>
        </child>
        <child type="label">
          <object class="GtkLabel" id="framelabel">
            <property name="visible">True</property>
            <property name="label">Frame</property>
          </object>
        </child>
      </object>
    </child>
    <child>
      <object class="GtkNotebook" id="notebook">
        <property name="visible">True</property>
        <child>
          <object class="GtkBox" id="page1">
            <property name="visible">True</property>
          </object>
        </child>
        <child type="tab">
          <object class="GtkLabel" id="tab1">
            <property name="visible">True</property>
            <property name="label">Page</property>
          </object>
        </child>
      </object>
    </child>
    <child>
      <object class="GtkNotebook" id="verticalnotebook">
        <property name="visible">True</property>
        <property name="tab-pos">left</property>
        <child>
          <object class="GtkBox" id="verticalpage">
            <property name="visible">True</property>
          </object>
        </child>
        <child type="tab">
          <object class="GtkLabel" id="verticaltab">
            <property name="visible">True</property>
            <property name="label">Page</property>
          </object>
        </child>
      </object>
    </child>
    <child>
      <object class="VclCustomWidget" id="customwidget">
        <property name="visible">True</property>
      </object>
    </child>
    <child>
      <object class="GtkToolbar" id="toolbar">
        <property name="visible">True</property>
        <child>
          <object class="GtkToolButton" id="toolbutton">
            <property name="visible">True</property>
            <property name="label">Tool</property>
          </object>
        </child>
      </object>
    </child>
  </object>
</interface>
